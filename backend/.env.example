# Copy to .env and fill in real values. Never commit .env.
PORT=3000

# MongoDB connection string.
# Use the DEV database (e.g. .../thriftyx_dev) for local work — NOT thriftyx_prod.
# The server logs which db it connected to on startup and flags production loudly.
MONGO_URI=

# Secret used to sign JWTs (use a long random string)
JWT_SECRET=

# Cloudinary (image uploads)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Transactional email — used by userController for review links / bulk mail
EMAIL_USER=
EMAIL_PASS=

# SMTP for OTP and notification email (utils/otp.js, utils/sendMail.js).
# These were previously hardcoded in source and committed — rotate them.
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Thrifty X <no-reply@thriftyx.com>"

# Twilio — WhatsApp OTP and SMS.
# The SID and auth token were hardcoded in utils/otp.js and utils/sendMessage.js
# and committed to git. ROTATE THEM in the Twilio console before going live.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Approved WhatsApp template containing a single {{1}} variable for the OTP
TWILIO_WHATSAPP_OTP_TEMPLATE_SID=
# Optional: a Twilio number for plain SMS, if not using the messaging service
TWILIO_SMS_FROM=

# Country code applied to bare 10-digit phone numbers
DEFAULT_COUNTRY_CODE=91

# Prints OTPs to the SERVER CONSOLE for local testing when email/WhatsApp
# delivery is not working. Ignored when NODE_ENV=production. The code is never
# sent to the browser. Leave unset/false anywhere real.
OTP_DEBUG=false

# Amazon S3 — gallery and event image storage.
# NOTE: two bucket names appear in existing data. `thriftyx-all-document`
# (singular) is the reachable one; `thriftyx-all-documents` (plural) returns 403
# and 1125 event image URLs point at it. See CHANGES.md §9h.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=thriftyx-all-document
S3_BASE_URL=https://thriftyx-all-document.s3.ap-south-1.amazonaws.com/

# Google Sign-In. Create an OAuth 2.0 Web client at
# https://console.cloud.google.com/apis/credentials and add your site origins
# (http://localhost:8080) to "Authorised JavaScript origins".
# The SAME value must be set as VITE_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=

# Payments. Anything other than "live" runs the MOCK gateway: no money moves,
# and /api/payment/verify marks the order paid immediately. Set to "live" only
# once Razorpay Checkout is wired into the browser (see CHANGES.md §9c).
PAYMENTS_MODE=mock

# Razorpay
RAZORPAY_LIVE_KEY=
RAZORPAY_TEST_KEY=
RAZORPAY_SECRET=
RAZORPAY_TEST_SECRET=

# Comma-separated list of browser origins allowed to call this API.
# Defaults to the local Vite dev ports for the frontend and admin panel.
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:5173
